rules_version = '2';

// OrgPulse Firestore rules (baseline for launch).
// Before deploying, create this document ONCE in the Firebase console:
//   Collection: artifacts > orgpulse-default-app (or your appId) > public > data > settings > access
//   Fields:
//     officerUids  (array)  -> UIDs of every officer (President, VP, Secretary...)
//     presidentUid (string) -> UID of the President only
// Find a UID in Firebase console > Authentication > Users.
// Note: the app's default appId is "orgpulse-default-app". Replace APP below if you change it.

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a real account (not the anonymous placeholder session)
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function accessDoc(app) {
      return get(/databases/$(database)/documents/artifacts/$(app)/public/data/settings/access).data;
    }

    function isOfficer(app) {
      return signedIn() && request.auth.uid in accessDoc(app).officerUids;
    }

    function isPresident(app) {
      return signedIn() && accessDoc(app).presidentUid == request.auth.uid;
    }

    match /artifacts/{app}/public/data {

      // Org settings and the access list: anyone signed in reads, officers write
      match /settings/{docId} {
        allow read: if signedIn();
        allow write: if isOfficer(app);
      }

      // Members: everyone signed in reads. Officers manage the roster.
      // A new account may create its own member record (authUid must match).
      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if isOfficer(app) ||
          (signedIn() && request.resource.data.authUid == request.auth.uid);
        allow update: if isOfficer(app) ||
          (signedIn() && resource.data.authUid == request.auth.uid &&
           request.resource.data.role == resource.data.role);
        allow delete: if isOfficer(app);
      }

      // Sessions, duties: read by signed-in users, written by officers
      match /sessions/{sessionId} {
        allow read: if signedIn();
        allow write: if isOfficer(app);
        match /checkins/{memberId} {
          allow read: if signedIn();
          allow write: if signedIn();   // members mark their own check-in (see limits)
        }
      }
      match /duties/{dutyId} {
        allow read: if signedIn();
        allow write: if isOfficer(app);
      }

      // Sanctions: officers manage; a member may only submit an appeal
      match /sanctions/{sanctionId} {
        allow read: if signedIn();
        allow create, delete: if isOfficer(app);
        allow update: if isOfficer(app) ||
          (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appeal']));
      }

      // Announcements: only the President posts, edits or deletes
      match /announcements/{annId} {
        allow read: if signedIn();
        allow create, update, delete: if isPresident(app);

        match /comments/{commentId} {
          allow read: if signedIn();
          // Anyone signed in comments as themselves
          allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
          // Officers moderate. Anyone may report (only the reports field changes).
          allow update: if isOfficer(app) ||
            (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports']));
          allow delete: if isOfficer(app);
        }
      }

      // Direct messages and group chats: participants only
      match /threads/{threadId} {
        allow read: if signedIn() && request.auth.uid in resource.data.participants;
        allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
        allow update: if signedIn() && request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'participants', 'name', 'type', 'group', 'createdBy', 'createdAt', 'id']);

        match /messages/{messageId} {
          allow read: if signedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/artifacts/$(app)/public/data/threads/$(threadId)).data.participants;
          allow create: if signedIn() && request.resource.data.senderId == request.auth.uid &&
            request.auth.uid in get(/databases/$(database)/documents/artifacts/$(app)/public/data/threads/$(threadId)).data.participants;
        }
      }
    }

    // Everything else is denied by default
  }
}
